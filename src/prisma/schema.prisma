generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  TEACHER
  STUDENT
  BURSAR
}

enum Curriculum {
  CBC
  CAMBRIDGE
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum PaymentMethod {
  CASH
  BANK
  MOBILE_MONEY
  CARD
  OTHER
}

enum AssignmentStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  student      Student?
  staff        Staff?
  auditLogs    AuditLog[]
}

model Student {
  id             String   @id @default(cuid())
  admissionNo    String   @unique
  firstName      String
  lastName       String
  dateOfBirth    DateTime?
  gender         String?
  curriculum     Curriculum
  grade          String
  stream         String?
  guardianName   String?
  guardianPhone  String?
  guardianEmail  String?
  admissionDate  DateTime @default(now())
  active         Boolean  @default(true)
  userId         String?  @unique
  user           User?    @relation(fields: [userId], references: [id])
  attendance     StudentAttendance[]
  enrollments    Enrollment[]
  results        Result[]
  payments       Payment[]
  assignments    AssignmentSubmission[]
}

model Staff {
  id          String   @id @default(cuid())
  employeeNo  String   @unique
  name        String
  email       String   @unique
  phone       String?
  department  String?
  jobTitle    String
  userId      String?  @unique
  user        User?    @relation(fields: [userId], references: [id])
  attendance  StaffAttendance[]
}

model Subject {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  curriculum  Curriculum
  results     Result[]
  assignments Assignment[]
  notes       LessonNote[]
}

model SchoolClass {
  id          String   @id @default(cuid())
  name        String
  grade       String
  stream      String?
  curriculum  Curriculum
  academicYear Int
  enrollments Enrollment[]
  @@unique([name, academicYear, curriculum])
}

model Enrollment {
  id        String @id @default(cuid())
  studentId String
  classId   String
  student   Student @relation(fields: [studentId], references: [id])
  schoolClass SchoolClass @relation(fields: [classId], references: [id])
  @@unique([studentId, classId])
}

model StudentAttendance {
  id        String @id @default(cuid())
  studentId String
  date      DateTime
  status    AttendanceStatus
  remarks   String?
  recordedBy String
  student   Student @relation(fields: [studentId], references: [id])
  @@unique([studentId, date])
}

model StaffAttendance {
  id        String @id @default(cuid())
  staffId   String
  date      DateTime
  status    AttendanceStatus
  remarks   String?
  staff     Staff @relation(fields: [staffId], references: [id])
  @@unique([staffId, date])
}

model FeeStructure {
  id          String   @id @default(cuid())
  name        String
  curriculum  Curriculum
  grade       String
  academicYear Int
  term        String
  amount      Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now())
}

model Payment {
  id          String @id @default(cuid())
  receiptNo   String @unique
  studentId   String
  amount      Decimal @db.Decimal(12, 2)
  method      PaymentMethod
  reference   String?
  paidAt      DateTime @default(now())
  receivedBy  String
  notes       String?
  student     Student @relation(fields: [studentId], references: [id])
}

model Expense {
  id          String   @id @default(cuid())
  category    String
  description String
  amount      Decimal  @db.Decimal(12, 2)
  spentAt     DateTime @default(now())
  recordedBy  String
  reference   String?
}

model Examination {
  id          String   @id @default(cuid())
  name        String
  curriculum  Curriculum
  grade       String
  term        String
  academicYear Int
  maxScore    Float    @default(100)
  results     Result[]
  createdAt   DateTime @default(now())
}

model Result {
  id            String @id @default(cuid())
  studentId     String
  subjectId     String
  examinationId String
  score         Float
  grade         String?
  teacherComment String?
  student       Student @relation(fields: [studentId], references: [id])
  subject       Subject @relation(fields: [subjectId], references: [id])
  examination   Examination @relation(fields: [examinationId], references: [id])
  @@unique([studentId, subjectId, examinationId])
}

model Assignment {
  id          String @id @default(cuid())
  title       String
  instructions String
  subjectId   String
  grade       String
  curriculum  Curriculum
  dueDate     DateTime?
  status      AssignmentStatus @default(DRAFT)
  fileUrl     String?
  createdBy   String
  createdAt   DateTime @default(now())
  subject     Subject @relation(fields: [subjectId], references: [id])
  submissions AssignmentSubmission[]
}

model AssignmentSubmission {
  id           String @id @default(cuid())
  assignmentId String
  studentId    String
  submittedAt  DateTime @default(now())
  fileUrl      String?
  textAnswer   String?
  score        Float?
  feedback     String?
  assignment   Assignment @relation(fields: [assignmentId], references: [id])
  student      Student @relation(fields: [studentId], references: [id])
  @@unique([assignmentId, studentId])
}

model LessonNote {
  id          String @id @default(cuid())
  title       String
  description String?
  subjectId   String
  grade       String
  curriculum  Curriculum
  fileUrl     String
  uploadedBy  String
  createdAt   DateTime @default(now())
  subject     Subject @relation(fields: [subjectId], references: [id])
}

model Announcement {
  id        String @id @default(cuid())
  title     String
  message   String
  audience  String
  createdBy String
  createdAt DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  entity    String
  entityId  String?
  createdAt DateTime @default(now())
  user      User @relation(fields: [userId], references: [id])
}


model GradingBand {
  id          String @id @default(cuid())
  curriculum  Curriculum
  name        String
  minScore    Float
  maxScore    Float
  grade       String
  description String?
  @@unique([curriculum, name, grade])
}
